    <!-- Vue liste pour le modèle estate.property -->
    <record id="offer" model="ir.ui.view">
        <field name="name">estate.property.offer.tree</field>
        <field name="model">estate_property_offer</field>
        <field name="arch" type="xml">
            <list string="Properties Offer" editable="bottom">
                <field name="price"/>
                    <field name="partner_id"/>
                    <field name="description"/>
                    <field name="validity"/> 
                    <field name="date_deadline"/>  
                    <field name="status"/>
                    <button name="action_accept_property_offer" string="Accept" type="object" icon="fa-check"/>
                    <button name="action_refuse_property_offer" string="Refuse" type="object" icon="fa-close"/> 
            </list>
        </field>
    </record>

    

</odoo>