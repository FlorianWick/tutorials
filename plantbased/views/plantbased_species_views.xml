<?xml version="1.0"?>
<odoo>
    <!-- Action window pour afficher la liste des arrosages -->
    <record id="plantbased_species_action" model="ir.actions.act_window">
        <field name="name">Espèces</field>
        <field name="res_model">plantbased_plant_species</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vue liste -->
    <record id="plantbased_plant_species_view_tree" model="ir.ui.view">
        <field name="name">plantbased_plant_species_tree</field>
        <field name="model">plantbased_plant_species</field>
        <field name="arch" type="xml">
            <list string="Espèces">
                <field name="name"/>
                <field name="watering_frequency_summer"/>
                <field name="watering_frequency_winter"/>
            </list>
        </field>
    </record>
    
    <!-- Vue form -->
    <record id="plantbased_plant_species_view_form" model="ir.ui.view">
        <field name="name">plantbased_plant_species_form</field>
        <field name="model">plantbased_plant_species</field>
        <field name="arch" type="xml">
            <form string="Mes familles">
                <header>
                </header>
                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group>
                            <field name="watering_frequency_summer"/>
                            <field name="watering_frequency_winter"/>
                        </group>
                    </group>
                    <notebook>                   
                        <page string="Description">
                            <field name="description" widget="html"/>                                          
                        </page>                        
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>      
</odoo>